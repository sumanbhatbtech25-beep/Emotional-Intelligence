# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → Settings → Secrets.
# Never commit the real secrets.toml — it is listed in .gitignore.

# Camera/microphone relay (TURN) — REQUIRED for the live camera on Streamlit Cloud.
# Without it the camera usually hangs on "Connection is taking longer than expected".
# Free: create a Hugging Face account → Settings → Access Tokens → New token (type "Read").
HF_TOKEN = "hf_your_read_token_here"
# Alternatives (use one): Cloudflare Realtime TURN or Twilio
# CLOUDFLARE_TURN_KEY_ID = "..."
# CLOUDFLARE_TURN_KEY_API_TOKEN = "..."
# TWILIO_ACCOUNT_SID = "..."
# TWILIO_AUTH_TOKEN = "..."

# Shared password for the whole app (optional, but recommended for public deployments).
# Use a long, unique passphrase: 16+ characters.
APP_PASSWORD = "replace-with-a-long-unique-passphrase"

# Optional: a larger Whisper model for better speech recognition (needs more memory).
# WHISPER_MODEL = "openai/whisper-small.en"
